# Keep the actual bearer token only in /etc/siwc-gateway.env (mode 0600).
GATEWAY_TOKEN=replace-with-a-private-token
SIWC_STORE=/var/lib/siwc-gateway/siwc
HOST=127.0.0.1
PORT=1457
API_BASE=https://api.openai.com/v1
TRUST_PROXY=1
MAX_RESPONSE_CONCURRENCY=8
MAX_UPLOAD_CONCURRENCY=2
MAX_UPLOAD_QUEUE=8
UPLOAD_QUEUE_WAIT_MS=30000
MAX_QUEUE=8
QUEUE_WAIT_MS=30000
RATE_LIMIT_PER_MIN=240
MAX_WIRE_BODY_BYTES=67108864
MAX_DECODED_BODY_BYTES=67108864
MAX_SPOOL_BYTES=537395200
MIN_SPOOL_FREE_BYTES=134217728
SPOOL_DIR=/var/lib/siwc-gateway/requests
BODY_IDLE_TIMEOUT_MS=30000
BODY_TOTAL_TIMEOUT_MS=300000
ZSTD_WINDOW_LOG_MAX=23
UPSTREAM_UPLOAD_TIMEOUT_MS=300000
UPSTREAM_HEADERS_TIMEOUT_MS=180000
UPSTREAM_ERROR_BODY_TIMEOUT_MS=10000
SSE_IDLE_TIMEOUT_MS=300000
MODELS_TTL_MS=300000
MODELS_TIMEOUT_MS=30000
MODELS_MAX_STALE_MS=1800000
