{
  "name": "dsh-llm-siwc",
  "version": "0.1.0",
  "description": "Sign in with ChatGPT (ChatGPT plan usage) provider plugin for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-authorization": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-commands": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": ">=0.2.0-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "chatgpt",
    "openai",
    "oauth",
